{
  "name": "sparqlist",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node index.mjs",
    "build": "cd frontend && npm ci --production=false && npm run build -- --environment=production --output-path=../public",
    "watch": "node --watch --watch-path=. --watch-path=lib index.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --watchman=false",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.29.0",
    "@types/node": "^25.3.5",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "@playwright/test": "1.58.2",
    "accepts": "^1.3.8",
    "commonmark": "^0.31.2",
    "connect-timeout": "^1.9.1",
    "express": "^5.2.1",
    "fontoxpath": "^3.34.0",
    "handlebars": "^4.7.8",
    "mime": "^4.1.0",
    "morgan": "^1.10.1",
    "parse5": "^8.0.0",
    "slimdom-sax-parser": "^1.5.3",
    "type-is": "^2.0.1",
    "xmlserializer": "^0.6.1"
  },
  "engines": {
    "node": ">=24"
  }
}
