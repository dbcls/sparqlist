{
  "name": "sparqlist",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "start": "node index.mjs",
    "build": "cd frontend && npm run build -- --outDir ../public --emptyOutDir",
    "frontend:dev": "cd frontend && npm run dev",
    "watch": "node --watch --watch-path=. --watch-path=lib index.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^25.3.5"
  },
  "dependencies": {
    "@playwright/test": "1.58.2",
    "accepts": "^1.3.8",
    "commonmark": "^0.31.2",
    "connect-timeout": "^1.9.1",
    "express": "^5.2.1",
    "fontoxpath": "^3.34.0",
    "handlebars": "^4.7.8",
    "mime": "^4.1.0",
    "morgan": "^1.10.1",
    "parse5": "^8.0.0",
    "slimdom-sax-parser": "^1.5.3",
    "type-is": "^2.0.1",
    "xmlserializer": "^0.6.1"
  },
  "engines": {
    "node": ">=24"
  }
}
